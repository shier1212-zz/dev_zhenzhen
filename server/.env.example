# ===== 应用 =====
APP_NAME=蓁蓁智能家居
APP_ENV=development
DEBUG=true

# ===== 数据库（SQLite，启用 WAL）=====
DB_URL=sqlite:///./data/zhz.db

# ===== JWT 认证 =====
JWT_SECRET=please-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ===== CORS（开发期：前台 5173 / 后台 5174）=====
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]

# ===== 文件上传 =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5242880

# ===== 留言限流 =====
MESSAGE_RATE_LIMIT_PER_HOUR=10
