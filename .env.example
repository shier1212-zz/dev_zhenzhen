# ============ 蓁蓁智能家居 · 生产环境变量（复制为 .env 后按需修改） ============

# 安全：务必替换为强随机值
JWT_SECRET=please-change-me-in-production

# CORS 允许来源（JSON 数组）
CORS_ORIGINS=["http://localhost:8080","http://localhost:8081"]

# 数据库连接（compose 中已强制指向数据卷；本机开发可改用相对路径）
DB_URL=sqlite:////app/data/zhz.db

# 上传目录
UPLOAD_DIR=/app/uploads

# 应用
APP_ENV=production
DEBUG=false
